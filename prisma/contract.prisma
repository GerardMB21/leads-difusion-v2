// use prisma-8

model mixin DefaultCols {
  id          Int                         @id @default(autoincrement())
  createdAt   TimestamptzString           @default(now())
  updatedAt   temporal.updatedAtString()
  deletedAt   TimestamptzString?
}

model Pipeline {
  +DefaultCols
  name            String             @unique
  order           Int
  default         Boolean            @default(false)
  leads           Lead[]             @relation("pipeline")
  leadsBefore     Lead[]             @relation("beforePipeline")
  workflowsFrom   WorkflowPipeline[] @relation("pipelineFrom")
  workflowsTo     WorkflowPipeline[] @relation("pipelineTo")
  @@rls
}

model Template {
  +DefaultCols
  name         String    @unique
  img          String?
  message      String
  leads        Lead[]
  @@rls
}

model Tag {
  +DefaultCols
  name         String    @unique
  leads        TagInLead[]
  @@rls
}

model Lead {
  +DefaultCols
  contactName      String
  phone            String
  order            Int
  enrollmentDate   TimestamptzString
  lastContact      TimestamptzString?
  lastResponseAt   TimestamptzString?
  movedAt          TimestamptzString?
  lastMessageId    String?
  lid              String?
  messageResponse  Boolean? @default(false)
  hasWhatsapp      Boolean  @default(true)
  templateId       Int?
  pipelineId       Int
  beforePipelineId Int?
  pipeline         Pipeline  @relation("pipeline", fields: [pipelineId], references: [id])
  beforePipeline   Pipeline? @relation("beforePipeline", fields: [beforePipelineId], references: [id])
  template         Template? @relation(fields: [templateId], references: [id])
  tags             TagInLead[]
  @@index([phone])
  @@index([lid])
  @@index([lastMessageId])
  @@index([pipelineId, deletedAt])
  @@rls
}

model TagInLead {
  tagId  Int
  tag    Tag    @relation(fields: [tagId], references: [id])
  leadId Int
  lead   Lead   @relation(fields: [leadId], references: [id])
  @@id([tagId, leadId])
  @@rls
}

model WorkflowPipeline {
  +DefaultCols
  name            String
  fromPipelineId  Int
  toPipelineId    Int
  whenResponse    Boolean   @default(false)
  whenNotResponse Boolean   @default(false)
  whenSendMessage Boolean   @default(false)
  waitingTime     Int       @default(0)
  fromPipeline    Pipeline  @relation("pipelineFrom", fields: [fromPipelineId], references: [id])
  toPipeline      Pipeline  @relation("pipelineTo", fields: [toPipelineId], references: [id])
  @@rls
}

enum DiffusionStatus {
  @@type("pg/text@1")
  active = "active"
  pending = "pending"
  cancelled = "cancelled"
  sending = "sending"
  completed    = "completed"
  failed  = "failed"
  stopped = "stopped"
}

model Diffusion {
  +DefaultCols
  pipelineId    Int?
  status        DiffusionStatus   @default(pending)
  total         Int
  processed     Int                   @default(0)
  sent          Int                   @default(0)
  failed        Int                   @default(0)
  startAt       TimestamptzString?
  finishedAt    TimestamptzString?
  nextSendAt    TimestamptzString?
  error         String?
  pipeline      Pipeline?             @relation("pipeline", fields: [pipelineId], references: [id])
  tags          TagInDiffusion[]
  templates     TemplateInDiffusion[]
  @@rls
}

model TagInDiffusion {
  tagId         Int
  tag           Tag         @relation(fields: [tagId], references: [id])
  diffusionId   Int
  diffusion     Diffusion   @relation(fields: [diffusionId], references: [id])
  @@id([tagId, diffusionId])
  @@rls
}

model TemplateInDiffusion {
  templateId    Int
  template      Template    @relation(fields: [templateId], references: [id])
  diffusionId   Int
  diffusion     Diffusion   @relation(fields: [diffusionId], references: [id])
  @@id([templateId, diffusionId])
  @@rls
}

enum LeadInDiffusionStatus {
  @@type("pg/text@1")
  pending = "pending"
  sending = "sending"
  sent    = "sent"
  failed  = "failed"
}

model LeadInDiffusion {
  +DefaultCols
  diffusionId   Int
  leadId        Int
  templateId    Int?
  status        LeadInDiffusionStatus   @default(pending)
  waited        Int?
  sentAt        TimestamptzString?
  error         String?
  diffusion     Diffusion               @relation(fields: [diffusionId], references: [id])
  lead          Lead                    @relation(fields: [leadId], references: [id])
  template      Template?               @relation(fields: [templateId], references: [id])
  @@rls
}
