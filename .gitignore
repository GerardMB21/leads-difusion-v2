# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
dist/
.env

# jetbrains setting folder
.idea/

# skills de agentes (se reinstalan desde skills-lock.json)
.agents/
.aider-desk/skills
.aider-desk/settings.local.json
.claude/skills/
.claude/settings.local.json
.cursor/skills/
.cursor/settings.local.json
.devin/skills/
.devin/settings.local.json

# graphify: keep only the report
graphify-out/*
!graphify-out/GRAPH_REPORT.md
